# Base16 {{scheme-name}} - foot color config
# Scheme by {{scheme-author}}
#
# Use from foot.ini with: include=<path to this file>
[colors-dark]
background={{base00-hex}}
foreground={{base05-hex}}
selection-background={{base0B-hex}}
selection-foreground={{base07-hex}}
urls={{base04-hex}}
# cursor=<text color> <cursor color>
cursor={{base00-hex}} {{base05-hex}}

# normal
regular0={{base03-hex}}
regular1={{base08-hex}}
regular2={{base0B-hex}}
regular3={{base0A-hex}}
regular4={{base0D-hex}}
regular5={{base0E-hex}}
regular6={{base0C-hex}}
regular7={{base06-hex}}

# bright (mirrors normal - matches ~/dotfiles/.config/alacritty/alacritty.toml, which
# uses identical normal/bright colors throughout, i.e. no distinct bright variants)
bright0={{base03-hex}}
bright1={{base08-hex}}
bright2={{base0B-hex}}
bright3={{base0A-hex}}
bright4={{base0D-hex}}
bright5={{base0E-hex}}
bright6={{base0C-hex}}
bright7={{base06-hex}}
