# Base16 {{scheme-name}} - tmux theme colours
# Scheme by {{scheme-author}}
#
# Use from tmux.conf with: source-file <path to this file>
#
# tmux 3.8+ draws its own UI (copy-mode selection, messages, menus, popups)
# with theme* colours. These default to fixed X11 names on 256-colour
# clients (themeyellow=darkgoldenrod), so map them onto the scheme. Accents
# use the ANSI names so they come from the terminal palette (foot/kitty,
# generated from this same scheme); black/greys/white use scheme hex values
# because the terminal's ANSI black is base03's gray, not a background.
set -s dark-theme-black "#{{base00-hex}}"
set -s dark-theme-dark-grey "#{{base01-hex}}"
set -s dark-theme-light-grey "#{{base04-hex}}"
set -s dark-theme-white "#{{base05-hex}}"
set -s dark-theme-red red
set -s dark-theme-green green
set -s dark-theme-yellow yellow
set -s dark-theme-blue blue
set -s dark-theme-magenta magenta
set -s dark-theme-cyan cyan
