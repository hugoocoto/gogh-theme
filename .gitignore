# Build artifacts (regenerated by build.sh).
/output/

# colors/*.lua is generated by build.sh from templates/colors/lua.mustache +
# schemes/*.yaml, so it's gitignored locally — contributors never need to
# commit it by hand. It's also the installable Neovim plugin entry point
# that lazy.nvim/vim.pack clone directly without running build.sh, so CI
# (.github/workflows/build.yml) rebuilds it on every push to main and force
# -commits it back (git add -f) to keep main's copy in sync.
#
# lua/base16-colorscheme.lua is handled the same way, but it's copied
# verbatim by build.sh from templates/lua/base16-colorscheme.lua (no
# mustache substitution — it's a shared engine, not per-scheme) rather
# than rendered per scheme. Edit templates/lua/base16-colorscheme.lua.
#
# Submodule-local build output (base16-builder-php/vendor) is handled by
# the submodule's own .gitignore, not this one.
/colors/*.lua
/lua/base16-colorscheme.lua

# palette/*.png (one preview image per scheme, generated by build.sh via
# the base16-spectrum-generator submodule) follows the same pattern:
# gitignored locally, force-committed by CI so README's embedded image
# stays in sync with schemes/*.yaml.
/palette/*.png

# Local venv for the palette generator's Python deps (numpy/Pillow) —
# needed because system Python is externally managed (PEP 668).
/.venv-palette/
